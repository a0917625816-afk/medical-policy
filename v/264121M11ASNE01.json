"【除外責任】"],["第十八條","【受益人受益權之喪失】"],["第十九條","【未還款項的扣除】"],["第二十條","【保險金額之減少】"],["第二十一條","【保險單借款及契約效力的停止】"],["第二十二條","【不分紅保險單】"],["第二十三條","【投保年齡的計算及錯誤的處理】"],["第二十四條","【受益人的指定及變更】"],["第二十五條","【變更住所】"],["第二十七條","【批註】"],["第二十八條","【管轄法院】"]],"pct":[],"mat":6}